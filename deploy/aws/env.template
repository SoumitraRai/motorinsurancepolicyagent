# Copy to /opt/rater/rater.env on the EC2 host (chmod 600). Never commit the filled-in copy.
# Public address Caddy serves; <elastic-ip-with-dashes>.sslip.io needs no domain purchase.
SITE_ADDRESS=
# Supabase → Connect → Session pooler URI (URL-encode special characters in the password, e.g. # → %23).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=policies
# Public values baked into the frontend at build time (Supabase URL + anon/publishable key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Extraction: no OpenRouter key, so the local rules extractor runs.
EXTRACTION_PROVIDER=rules
OPENROUTER_API_KEY=
EXTRACTION_MODEL=
GRID_DATE_POLICY=strict
BROKER_ELIGIBILITY=assume_base
LESSER_PERCENT_MEANS=points
OCR_WORKERS=1
READ_PAGES=20
